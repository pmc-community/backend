#   SERVER_NAME=backend-template  DEPLOY_ENV=local  DATA_SOURCE=fs
#   listens on HTTPS, port 3000 (key.pem, cert.pem are in the image); auto-reload follows RELOAD in the config
#   keystore: /app/keystore.json (baked into the image)
#
# Build:  docker build -f Dockerfile -t backend-template .
# Run:    docker run -d --name backend-template -p 3000:3000 \
#           --read-only --tmpfs /tmp --cap-drop ALL \
#           --restart unless-stopped backend-template
#
# One container = one process: rate limiters, replay store and circuit breaker are
#   in memory, so scale by running more containers behind a proxy only if that is acceptable.
# Variables passed with `docker run -e` override the baked .env (the server never
#   overrides variables that are already set).

ARG BASE_IMAGE=ubuntu:24.04

# ---------------------------------------------------------------------------
# Stage 1 - dependencies in a virtualenv
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv

# Runtime requirements, captured from requirements.txt when this file was generated
# (left out as dev/test only: pytest>=8)
COPY <<"EOF_REQUIREMENTS" /tmp/requirements.txt
fastapi>=0.115
uvicorn[standard]>=0.30
pydantic>=2.5
python-dotenv>=1.0
httpx>=0.27
psutil>=5.9
EOF_REQUIREMENTS
RUN /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt

# ---------------------------------------------------------------------------
# Stage 2 - runtime image (same Ubuntu base, no pip / build leftovers)
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS runtime
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin app

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app

# --- application code and data (the server reads ./data and ./.routeignore relative to its cwd)
COPY main.py ./main.py
COPY app ./app
COPY data ./data
COPY .routeignore ./.routeignore
RUN chmod -R u=rwX,go=rX main.py app data .routeignore

# --- configuration and secrets: readable by root and the app group only
COPY --chown=root:app --chmod=0640 .env ./.env
COPY --chown=root:app --chmod=0640 key.pem ./key.pem
COPY --chown=root:app --chmod=0640 cert.pem ./cert.pem
COPY --chown=root:app --chmod=0640 keystore.json ./keystore.json

# --- container health check (stdlib only, no curl needed)
COPY --chmod=0644 <<"EOF_HEALTHCHECK" /usr/local/lib/healthcheck.py
"""Container health check: GET /status on the local port.

The server validates the Host header against data/hostValidation/host-allow-list.txt,
so the first allowed host is sent (read at check time, so list edits are honoured).
"""
import os
import ssl
import sys
import urllib.request

port = os.environ.get("DEV_PORT") or "3000"
host = "localhost"
scheme = "https"
# the local certificate is self-signed / issued for another name: only reachability matters here
context = ssl._create_unverified_context() if scheme == "https" else None

try:
    with open("/app/data/hostValidation/host-allow-list.txt", encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if line and not line.startswith("#"):
                host = line
                break
except OSError:
    pass

request = urllib.request.Request(
    f"https://127.0.0.1:{port}/status",
    headers={"Host": host, "User-Agent": "Mozilla/5.0 (compatible; docker-healthcheck/1.0)"},
)

try:
    with urllib.request.urlopen(request, timeout=4, context=context) as response:
        sys.exit(0 if response.status == 200 else 1)
except Exception:
    sys.exit(1)
EOF_HEALTHCHECK

# Settings read from the server configuration at generation time.  They win over the baked
# .env (the server never overrides variables that are already set), so the container
# behaves as configured even when .env is edited later or an -e flag is given.
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEPLOY_ENV=local \
    DATA_SOURCE=fs \
    DEV_PORT=3000 \
    KEYSTORE_PATH=/app/keystore.json

# Build-time smoke test: the app must import, load every data list and register its routes.
# The route loader only prints when a route fails to load, so the build fails on those messages.
RUN python - <<"EOF_SMOKE"
import contextlib
import io
import sys

captured = io.StringIO()

with contextlib.redirect_stdout(captured):
    import main  # noqa: F401  - loads .env, every data list and every route

output = captured.getvalue()
print(output, end="")

problems = [
    line for line in output.splitlines()
    if "Failed to load route" in line or "Skipping invalid route definition" in line
]

if problems:
    sys.exit("Route loading problems:\n" + "\n".join(problems))
EOF_SMOKE

USER app
EXPOSE 3000
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["python", "/usr/local/lib/healthcheck.py"]

# exec form: python is PID 1 and receives SIGTERM directly (graceful drain)
CMD ["python", "main.py"]

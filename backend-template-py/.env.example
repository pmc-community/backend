# general
SERVER_NAME=backend-template
MAX_HOST_LENGTH=255

# change this and the PORT will change as defined below
# use simprod to test local but with production settings = server runs from dist as in production
DEPLOY_ENV=local

DATA_SOURCE=fs # the source where data is available for lists such as blocked IPs or allowed headers
DATA_RELOAD_INTERVAL=1000 # interval for checking if data (such as IP deny list) changed for hot re-load it

#-------------------------
# local dev
KEYSTORE_PATH=./keystore.json
DEV_PORT=3000

#-------------------------
# prod
# use port 80 to test local but with prod settings and with http, not https
# https may not work when testing local with prod settings because of the SSL cert
PROD_PORT=443 # normal operation
#PROD_PORT=80 # when testing with simprod 

DEFAULT_SLOW_RESPONSE=1000

PAGINATION_MAX_REC_PER_PAGE=100
PAGINATION_DEFAULT_REC_PER_PAGE=50
PAGINATION_MAX_PAGES=10000
PAGINATION_MAX_RECORDS=1000000

# limits
# | -------------------------------------------------------------------------------------------------------- |
# | Limiter              | Applies to                     |        Limit |          Window | Response        |
# | -------------------- | ------------------------------ | -----------: | --------------: | --------------- |
# | `rateLimiter`        | All requests                   | 100 requests |   1 minute / IP | `429` after 100 |
# | `authFailureLimiter` | Failed authentication attempts |  10 failures | 15 minutes / IP | `429` after 10  |

# requests/minute/IP
minuteInMs=60000
maxRqPerMin=100

# rq auth failures
rqFailuresInterval=15
maxRqAuthFailures=10

# body, response, header size
maxBytesBase=1024 # use it as maxBytesBase * maxBytesBase for 1MB and so on
maxResponseBytesBase=1024

DEFAULT_MAX_HEADER_BYTES = 16; # in KB
DEFAULT_MAX_HEADER_VALUE_BYTES = 8 # in KB
DEFAULT_MAX_HEADER_COUNT = 50;

# per key/client limits
# to be used for sensitive endpoints (i.e. auth flows) for limiting the attempts to get a valid server session 
# by trying different random values of the access token or authorization code
DEFAULT_PER_KEY_MAX_REQUESTS=10

# timeout (seconds)
defaultTimeout=30

# Query Parameters limiter
DEFAULT_MAX_QUERY_PARAMETERS=20 # max no of parameters allowed
DEFAULT_MAX_KEY_LENGTH=50 # max size of a parameter name
DEFAULT_MAX_VALUE_LENGTH=500 # max size of a parameter value
DEFAULT_MAX_QUERY_STRING_LENGTH=4000 # max size of the total query parameters string

# URL limiter
MAX_URL_LENGTH=1024

# Suspicious requests detector
SRD_THRESHOLD=5
SRD_BLOCK_SUSPICIOUS_REQUESTS=false

# Concurrency limiter
CO_MAX_ALLOWED=10

# Signed requests
SIGNRQ_MAX_AGE_SECONDS=300
SIGNRQ_MAX_FUTURE_SECONDS=30
SIGNRQ_MAX_NONCE_LENGTH=256
SIGNRQ_CLEANUP_INTERVAL_MS=60000
SIGNRQ_MAX_ENTRIES=1000000
SIGNRQ_TIMESTAMP_HEADER=X-Signature-Timestamp
SIGNRQ_NONCE_HEADER=X-Signature-Nonce
SIGNRQ_SIGNATURE_HEADER=X-Signature

# Circuit breaker
# | State              | Condition                                                   | Action                                 |
# | -------------------| ----------------------------------------------------------- | -------------------------------------- |
# | CLOSED             | Normal operation; failures below threshold                  | Allow requests                         |
# | OPEN               | Failure count ≥ `failureThreshold` within `failureWindowMs` | Stop processing requests; return `503` |
# | OPEN               | `openDurationMs` has not elapsed                            | Keep rejecting requests                |
# | OPEN → HALF_OPEN   | `openDurationMs` has elapsed                                | Allow a limited recovery test          |
# | HALF_OPEN → CLOSED | Recovery test succeeds                                      | Resume normal traffic                  |
# | HALF_OPEN → OPEN   | Recovery test fails                                         | Block traffic again                    |

CB_FAILURE_THRESHOLD=20
CB_FAILURE_WINDOW_MS=30000
CB_OPEN_DURATION_MS=10000 # the duration of keeping the circuit open and not accepting requests
CB_HALF_OPEN_MAX_REQUESTS=1 # number of requests accepted while the circuit allows half operation

# Graceful shutdown
GRSD_WAIT_FOR_DRAIN_MS=5000 # how long the server waits to finish pending requests until shutdown